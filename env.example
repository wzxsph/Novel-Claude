# Generic OpenAI-compatible chat endpoint
LLM_PROVIDER=minimax
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
MODEL_ID=MiniMax-M2.7
FLASH_MODEL_ID=MiniMax-M2.7-highspeed

# Required only for Zhipu Batch API and the built-in Zhipu embedding RAG skill.
# When LLM_PROVIDER=zhipu, LLM_API_KEY is used as a fallback.
ZHIPU_API_KEY=
BATCH_MODEL_ID=glm-4

# Optional workspace override. Empty uses the active REPL project or config.json.
NOVEL_NAME=

# Legacy variables are still accepted. The known MiniMax /anthropic endpoint is
# normalized to its /v1 OpenAI-compatible endpoint by this OpenAI-SDK runtime:
# MINIMAX_API_KEY, MINIMAX_BASE_URL, ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL
